# BharatGram - Environment Configuration
# Tailored for Indian Social Network & Commerce Deployment

# Next.js Server
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication (JWT & Google OAuth)
JWT_SECRET=super_secret_bharatgram_jwt_key_2026
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Indian SMS Gateway for Mobile OTP (+91)
# Supported: MSG91 / Gupshup / Twilio
SMS_GATEWAY_PROVIDER=msg91
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_dlt_approved_template_id

# Indian Payment Gateway (Razorpay)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# MongoDB Connection
MONGODB_URI=mongodb+srv://admin:password@cluster0.bharatgram.mongodb.net/bharatgram?retryWrites=true&w=majority

# Media Storage (AWS S3 Mumbai Region ap-south-1 or Firebase Storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=bharatgram-media-cdn
NEXT_PUBLIC_CDN_DOMAIN=https://cdn.bharatgram.in
